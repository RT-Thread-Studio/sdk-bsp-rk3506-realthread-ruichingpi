import os
from building import *

# CPU usage is a common system service available to every App by default.
objs = DefineGroup(
    name = 'cpu_usage',
    src = Glob('*.c'),
    depend = [],
    CPPPATH = [os.path.join(GetCurrentDir(), '.')])

Return('objs')
